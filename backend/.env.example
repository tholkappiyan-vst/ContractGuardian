# ─────────────────────────────────────────────────────────────────────────────
# ContractAI Guardian — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://contractai:password@localhost:5432/contractai

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI APIs ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ─── Object Storage (S3 / R2 / MinIO) ───────────────────────────────────────
S3_BUCKET=contractai-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For Cloudflare R2 or MinIO:
# S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
S3_ENDPOINT_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION_PREFIX=contract
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,png,jpg,tiff

# ─── CORS (comma-separated origins) ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
