# ─────────────────────────────────────────────────────────────────────────────
# ContractAI Guardian — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://contractai:password@localhost:5432/contractai

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI API (Gemini — FREE tier: 15 RPM, 1M tokens/day) ───────────────────
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ─── File Storage (local disk) ──────────────────────────────────────────────
UPLOAD_DIR=./data/uploads

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION_PREFIX=contract
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=8

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,png,jpg,tiff

# ─── CORS (comma-separated origins) ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
